# MinerU API - CPU-only image for split VLM (connects to external layout + extraction servers)
# Build from MinerU repo root: docker build -f docker/Dockerfile.api -t adeo-mineru-api .
FROM python:3.11-slim-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-noto-core fonts-noto-cjk fontconfig libgl1 libglib2.0-0 \
    && fc-cache -fv && rm -rf /var/lib/apt/lists/*

# Install MinerU from local source (this repo)
COPY . /tmp/MinerU
RUN pip install --no-cache-dir "/tmp/MinerU[core]" fastapi uvicorn python-multipart httpx \
    && rm -rf /tmp/MinerU

# SSL patch + entrypoint (connects to MINERU_VL_SERVER, MINERU_VL_SERVER_EXTRACTION)
WORKDIR /app
COPY docker/ssl_patch.py /app/
COPY docker/entrypoint-api.sh /app/entrypoint.sh
RUN cp /app/ssl_patch.py $(python3 -c "import site; print(site.getsitepackages()[0])")/sitecustomize.py \
    && chmod +x /app/entrypoint.sh

ENV MINERU_MODEL_SOURCE=local
ENV MINERU_DEFAULT_BACKEND=hybrid-http-client
EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.sh"]
