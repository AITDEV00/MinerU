# MinerU API with parse_method=vlm (Split Layout + Extraction)
# Layout via MinerU2.5, extraction via Qwen3-VL. Models baked for air-gapped deployment.
# Build from MinerU root: docker build -f docker/Dockerfile.api-split-vlm -t adeo-mineru-api:$(date +%d-%m-%Y) .
# Or: cd docker && make build-split-vlm
#
# Base image: default is AWS Public ECR mirror of docker.io/library/python (same content, avoids
# Docker Hub "429 Too Many Requests" for anonymous pulls). Override if your network blocks ECR:
#   docker build --build-arg PYTHON_BASE=python:3.11-slim-bookworm ...
# (use `docker login` at hub.docker.com first to raise Hub pull limits.)

ARG PYTHON_BASE=public.ecr.aws/docker/library/python:3.11-slim-bookworm
FROM ${PYTHON_BASE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    fonts-noto-core fonts-noto-cjk fontconfig libgl1 libglib2.0-0 \
    && fc-cache -fv && rm -rf /var/lib/apt/lists/*

# Install MinerU from local source (patched with split VLM)
COPY . /tmp/MinerU
RUN pip install --no-cache-dir "/tmp/MinerU[core]" fastapi uvicorn python-multipart httpx \
    && rm -rf /tmp/MinerU

RUN mkdir -p /root/.cache/huggingface

# Bake pipeline models (OCR, layout, etc.) at build time for air-gapped app cluster.
# VLM runs remotely on GPU; only pipeline models needed for smart routing OCR path.
RUN MINERU_MODEL_SOURCE=huggingface mineru-models-download -s huggingface -m pipeline

WORKDIR /app
COPY docker/ssl_patch.py /app/
COPY docker/entrypoint-api-split-vlm.sh /app/entrypoint.sh
RUN cp /app/ssl_patch.py $(python3 -c "import site; print(site.getsitepackages()[0])")/sitecustomize.py \
    && chmod +x /app/entrypoint.sh

ENV MINERU_MODEL_SOURCE=local
ENV MINERU_DEFAULT_BACKEND=hybrid-http-client
ENV HF_HOME=/root/.cache/huggingface
EXPOSE 8000

ENTRYPOINT ["/app/entrypoint.sh"]
